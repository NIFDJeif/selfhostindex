---
import Base from '../layouts/Base.astro';
import { meta } from '../lib/data';
---
<Base title="Page not found" description="That page does not exist." path="/404" noindex={true}>
  <div class="wrap narrow prose center" style="padding-block:3rem">
    <h1>Page not found</h1>
    <p class="lede" style="margin-inline:auto;margin-top:.8rem">
      That URL does not match anything in the catalogue.
    </p>
    <p style="margin-top:1.6rem">
      <a class="btn" href="/software">Browse all {meta.counts.software} projects</a>
      <a class="btn btn-ghost" href="/" style="margin-left:.5rem">Home</a>
    </p>
  </div>
</Base>
