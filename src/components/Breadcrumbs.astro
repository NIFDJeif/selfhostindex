---
export interface Props { items: { label: string; href?: string }[] }
const { items } = Astro.props;
---
<nav class="crumbs" aria-label="Breadcrumb">
  <a href="/">Home</a>
  {items.map((it) => (
    <>
      <span aria-hidden="true">/</span>
      {it.href ? <a href={it.href}>{it.label}</a> : <span>{it.label}</span>}
    </>
  ))}
</nav>
